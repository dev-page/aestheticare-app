rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return userDoc().data;
    }

    function roleKey() {
      return (userData().role == 'Clinic Admin' || userData().role == 'Clinicadmin' || userData().role == 'clinicadmin')
        ? 'Owner'
        : (userData().role == 'Superadmin' || userData().role == 'SuperAdmin' || userData().role == 'superadmin')
          ? 'Superadmin'
          : userData().role;
    }

    function isSuperadmin() {
      return userData().role == 'Superadmin' || userData().role == 'SuperAdmin' || userData().role == 'superadmin';
    }

    function isClinicOwner() {
      return isSignedIn()
        && (userData().role == 'Owner'
          || userData().role == 'owner'
          || userData().role == 'Clinic Owner'
          || userData().role == 'clinic owner'
          || userData().role == 'Clinic Admin'
          || userData().role == 'clinicadmin'
          || userData().role == 'Clinic Administrator'
          || userData().role == 'clinicadministrator'
          || userData().userType == 'Owner'
          || userData().userType == 'owner');
    }

    function isCustomer() {
      return isSignedIn()
        && (userData().role == 'Customer'
          || userData().role == 'customer'
          || userData().userType == 'Customer'
          || userData().userType == 'customer');
    }

    function isValidPhilippineMobile(value) {
      return value is string && value.matches('^\\+639[0-9]{9}$');
    }

    function applicantCannotChangeVerificationFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ownerId', 'organizationOwnerId',
        'status', 'approvalStatus', 'registrationStatus', 'verificationStatus', 'verificationResults', 'verificationJob', 'registrationOcrSnapshot',
        'verificationProcessedAt', 'verificationProcessedBy', 'approvedAt',
        'approvedBy', 'rejectedAt', 'rejectionReason', 'reviewedBy', 'reviewedAt',
        'subscriptionPlan', 'plan', 'paymentStatus', 'paymentId',
        'subscriptionStartedAt', 'subscriptionExpiresAt', 'subscriptionUpdatedAt',
        'subscriptionAccessStatus', 'subscriptionStatus', 'subscriptionGraceStartedAt',
        'subscriptionGraceEndsAt', 'subscriptionRetentionStartedAt',
        'subscriptionRetentionEndsAt', 'subscriptionDispositionStatus',
        'subscriptionDispositionEligibleAt',
        'subscriptionTrialPlan', 'subscriptionTrialUsedAt',
        'subscriptionTrialStartedAt', 'subscriptionTrialEndsAt',
        'subscriptionOnboardingRequired', 'subscriptionOnboardingCompletedAt',
        'pendingSubscriptionPlan', 'pendingSubscriptionApplyAt',
        'pendingSubscriptionRequestedAt', 'pendingSubscriptionChangeType',
        'pendingSubscriptionPaymentId', 'pendingSubscriptionPaidAt',
        'pendingSubscriptionNextExpiresAt', 'pendingSubscriptionBillingCycle',
        'platformAgreementAcceptance', 'platformAgreementAcceptances',
        'deliveryFees', 'deliveryFeePolicy'
      ]);
    }

    // Applicants save each registration document immediately so an interrupted
    // registration can be resumed. This is intentionally limited to the
    // document-draft fields while the backend has the clinic in its document
    // submission stage; it cannot change approval or verification data.
    function applicantCanSaveClinicDocumentDraft() {
      return (resource.data.approvalStatus == 'Pending Document Submission'
          || resource.data.approvalStatus == 'Pending Documents')
        && (request.resource.data.approvalStatus == 'Pending Document Submission'
          || request.resource.data.approvalStatus == 'Pending Documents')
        && (!('expiryResubmissionExpiresAt' in resource.data)
          || request.time <= resource.data.expiryResubmissionExpiresAt)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'draftDocuments', 'draftDocumentsUpdatedAt'
        ]);
    }

    // Approved owners must be able to finish their initial clinic profile
    // before selecting a subscription. These checks cover only that setup,
    // leaving subscription, approval, ownership and other fields protected.
    function validOnboardingDetails(details) {
      return details is map
        && details.keys().hasOnly(['businessEmail', 'contactNumber', 'description', 'services'])
        && details.keys().hasAll(['businessEmail', 'contactNumber', 'description', 'services'])
        && details.businessEmail is string && details.businessEmail.size() > 0 && details.businessEmail.size() <= 254
        && details.contactNumber is string && details.contactNumber.matches('^9[0-9]{9}$')
        && details.description is string && details.description.size() > 0 && details.description.size() <= 1000
        && details.services is list && details.services.size() > 0 && details.services.size() <= 50;
    }

    function validOnboardingDay(day) {
      return day is map && day.keys().hasOnly(['closed', 'ranges'])
        && day.keys().hasAll(['closed', 'ranges'])
        && day.closed is bool && day.ranges is list
        && day.ranges.size() > 0 && day.ranges.size() <= 8;
    }

    function validOnboardingHours(hours) {
      return hours is map
        && hours.keys().hasOnly(['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'])
        && hours.keys().hasAll(['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'])
        && validOnboardingDay(hours.monday) && validOnboardingDay(hours.tuesday)
        && validOnboardingDay(hours.wednesday) && validOnboardingDay(hours.thursday)
        && validOnboardingDay(hours.friday) && validOnboardingDay(hours.saturday)
        && validOnboardingDay(hours.sunday);
    }

    function validOnboardingDraft(draft) {
      return draft is map
        && draft.keys().hasOnly(['clinicDetails', 'availability', 'completedStep', 'updatedAt', 'profilePicture', 'bannerPicture'])
        && draft.keys().hasAll(['clinicDetails', 'completedStep', 'updatedAt'])
        && validOnboardingDetails(draft.clinicDetails)
        && draft.completedStep in [1, 2, 3]
        && draft.updatedAt == request.time
        && (!('availability' in draft) ? draft.completedStep == 1 : validOnboardingHours(draft.availability))
        && (!('profilePicture' in draft) || (draft.profilePicture is string && draft.profilePicture.size() <= 2048))
        && (!('bannerPicture' in draft) || (draft.bannerPicture is string && draft.bannerPicture.size() <= 2048));
    }

    function ownerCanSaveOnboardingCheckpoint() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let draft = request.resource.data.get('onboardingDraft', null);
      return changed.hasOnly(['onboardingDraft', 'profilePicture', 'bannerPicture', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validOnboardingDraft(draft)
        && (!changed.hasAny(['profilePicture', 'bannerPicture'])
          || (draft.completedStep == 3
            && request.resource.data.get('profilePicture', '') == draft.get('profilePicture', '')
            && request.resource.data.get('bannerPicture', '') == draft.get('bannerPicture', '')));
    }

    function ownerCanCompleteOnboarding() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let draft = resource.data.get('onboardingDraft', null);
      return changed.hasOnly([
          'profilePicture', 'bannerPicture', 'businessEmail', 'contactNumber', 'description', 'services',
          'operatingHours', 'isPublished', 'publishedAt', 'clinicSetupRequired', 'clinicSetupCompletedAt',
          'clinicSetupVersion', 'onboardingDraft', 'clinicSetupPlanSkippedAt', 'updatedAt'
        ])
        && draft is map && draft.get('completedStep', 0) == 3
        && validOnboardingDetails(draft.clinicDetails)
        && validOnboardingHours(draft.availability)
        && request.resource.data.businessEmail == draft.clinicDetails.businessEmail
        && request.resource.data.contactNumber == draft.clinicDetails.contactNumber
        && request.resource.data.description == draft.clinicDetails.description
        && request.resource.data.services == draft.clinicDetails.services
        && request.resource.data.operatingHours == draft.availability
        && request.resource.data.profilePicture == draft.get('profilePicture', '')
        && request.resource.data.bannerPicture == draft.get('bannerPicture', '')
        && request.resource.data.isPublished == true && request.resource.data.publishedAt == request.time
        && request.resource.data.clinicSetupRequired == false && request.resource.data.clinicSetupCompletedAt == request.time
        && request.resource.data.clinicSetupVersion == 1 && !('onboardingDraft' in request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (!changed.hasAny(['clinicSetupPlanSkippedAt']) || request.resource.data.clinicSetupPlanSkippedAt == request.time);
    }

    function ownerCanSaveInitialOnboarding(clinicId) {
      return clinicId == request.auth.uid && isClinicOwner()
        && userData().get('status', '') in ['Active', 'active']
        && resource.data.get('approvalStatus', '') == 'Approved'
        && resource.data.get('clinicSetupRequired', false) == true
        && resource.data.get('clinicSetupCompletedAt', null) == null
        && (ownerCanSaveOnboardingCheckpoint() || ownerCanCompleteOnboarding());
    }

    function rolePermissions() {
      return exists(/databases/$(database)/documents/rolePermissions/$(roleKey()))
        ? get(/databases/$(database)/documents/rolePermissions/$(roleKey())).data.permissions
        : [];
    }

    function hasPermission(permission) {
      // A clinic owner is the authority for their own organization. Individual
      // staff still require explicit permissions, and every caller must pass
      // the surrounding branch-scope check before this helper grants access.
      return isSuperadmin()
        || isClinicOwner()
        || (userData().permissions != null && userData().permissions.hasAny([permission]))
        || (userData().effectivePermissions != null && userData().effectivePermissions.hasAny([permission]))
        || (rolePermissions() != null && rolePermissions().hasAny([permission]))
        || ((userData().userType == 'Staff' || userData().userType == 'staff'
            || userData().userType == 'Employee' || userData().userType == 'employee')
          && (permission == 'activities:view' || permission == 'notifications:view'
            || permission == 'leave:create' || permission == 'overtime:create'))
        ;
    }





    function clinicDoc(branchId) {
      return get(/databases/$(database)/documents/clinics/$(branchId));
    }

    function isOwnerOfBranch(branchId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/clinics/$(branchId))
        && clinicDoc(branchId).data.ownerId == request.auth.uid;
    }

    function isStaffOfBranch(branchId) {
      return isSignedIn()
        && (userData().branchId == branchId
          || (userData().branchIds != null && userData().branchIds.hasAny([branchId])));
    }

    function canAccessBranch(branchId) {
      return isOwnerOfBranch(branchId) || isStaffOfBranch(branchId);
    }

    function isStaffOfOwner(ownerId) {
      return isSignedIn()
        && (userData().userType == 'Staff' || userData().userType == 'staff'
          || userData().userType == 'Employee' || userData().userType == 'employee')
        && (userData().organizationOwnerId == ownerId
          || (userData().branchId != null
            && exists(/databases/$(database)/documents/clinics/$(userData().branchId))
            && clinicDoc(userData().branchId).data.ownerId == ownerId));
    }

    function isAssignedClinicRole(roleId) {
      return isSignedIn()
        && (userData().customRoleId == roleId
          || (userData().customRoleIds != null && userData().customRoleIds.hasAny([roleId])));
    }

    function canManageClinicRoles(ownerId) {
      return isSuperadmin()
        || (isClinicOwner() && ownerId == request.auth.uid)
        || (isStaffOfOwner(ownerId) && hasPermission('roles:manage'));
    }

    function isPublicClinic(clinicId) {
      return exists(/databases/$(database)/documents/clinics/$(clinicId))
        && clinicDoc(clinicId).data.isPublished == true;
    }

    function publicClinicDoc(clinicId) {
      return get(/databases/$(database)/documents/publicClinics/$(clinicId));
    }

    function isCustomerDiscoverablePublicClinic(clinicId) {
      return clinicId is string
        && clinicId.size() > 0
        && exists(/databases/$(database)/documents/publicClinics/$(clinicId))
        && publicClinicDoc(clinicId).data.get('isPublished', false) == true
        && publicClinicDoc(clinicId).data.get('customerAccess', false) == true
        && publicClinicDoc(clinicId).data.get('status', '') != 'inactive'
        && publicClinicDoc(clinicId).data.get('status', '') != 'Inactive'
        && (publicClinicDoc(clinicId).data.get('customerAccessUntil', null) == null
          || publicClinicDoc(clinicId).data.get('customerAccessUntil', null) > request.time);
    }

    function canUseClinicInbox(branchId) {
      return isSignedIn()
        && branchId is string
        && branchId.size() > 0
        && canAccessBranch(branchId)
        && hasPermission('inbox:view');
    }

    function isShortMessage(value) {
      return value is string && value.size() > 0 && value.size() <= 4000;
    }

    function threadCustomerOwns(threadId) {
      let thread = get(/databases/$(database)/documents/chatThreads/$(threadId)).data;
      return isSignedIn()
        && thread.customerId == request.auth.uid
        && threadId == thread.branchId + '_' + request.auth.uid;
    }

    function clinicCanUseThread(threadId) {
      let thread = get(/databases/$(database)/documents/chatThreads/$(threadId)).data;
      return thread.branchId is string
        && canUseClinicInbox(thread.branchId)
        && threadId == thread.branchId + '_' + thread.customerId;
    }

    function clinicHasSubscription(branchId) {
      return exists(/databases/$(database)/documents/clinics/$(branchId))
        && (clinicDoc(branchId).data.get('subscriptionPlan', '') in ['basic', 'premium']
          || clinicDoc(branchId).data.get('paymentStatus', '') == 'trial');
    }

    // Use the server timestamp so expiry restrictions do not depend on the UI
    // or on the hourly maintenance job running first.
    function subscriptionAllowsBusinessWrite(branchId) {
      return clinicHasSubscription(branchId)
        // Subscription is a clinic-wide authorization layer. Role permissions
        // are checked by the caller, but can never override an expired clinic.
        && (clinicDoc(branchId).data.get('isActive', true) != false)
        && (
          (clinicDoc(branchId).data.get('subscriptionAccessStatus', '') == 'grace_period'
            && clinicDoc(branchId).data.get('subscriptionGraceEndsAt', null) != null
            && request.time < clinicDoc(branchId).data.subscriptionGraceEndsAt)
          || (clinicDoc(branchId).data.get('subscriptionAccessStatus', '') in ['trial', 'active', 'canceled']
            && (clinicDoc(branchId).data.get('subscriptionExpiresAt', null) == null
              || request.time < clinicDoc(branchId).data.subscriptionExpiresAt))
          || (clinicDoc(branchId).data.get('subscriptionAccessStatus', '') in ['trial', 'active', 'canceled']
            && clinicDoc(branchId).data.get('subscriptionGraceEndsAt', null) != null
            && request.time < clinicDoc(branchId).data.subscriptionGraceEndsAt)
          // Legacy records remain usable until migrated, but an expired legacy
          // date is never a bypass.
          || (!('subscriptionAccessStatus' in clinicDoc(branchId).data)
            && (!('subscriptionExpiresAt' in clinicDoc(branchId).data)
              || clinicDoc(branchId).data.subscriptionExpiresAt == null
              || request.time < clinicDoc(branchId).data.subscriptionExpiresAt))
        );
    }

    function planAllowsBookingAvailability(branchId) {
      return exists(/databases/$(database)/documents/clinics/$(branchId))
        && subscriptionAllowsBusinessWrite(branchId)
        && (clinicDoc(branchId).data.subscriptionPlan == 'basic'
          || clinicDoc(branchId).data.subscriptionPlan == 'premium'
          || clinicDoc(branchId).data.get('paymentStatus', '') == 'trial');
    }

    // Attendance, shifts, leave, overtime, base pay, payroll and payslips
    // are deliberately Premium-only. Basic remains focused on appointments,
    // consultations, product orders, inventory and operational finance.
    function planAllowsWorkforceManagement(branchId) {
      return exists(/databases/$(database)/documents/clinics/$(branchId))
        && subscriptionAllowsBusinessWrite(branchId)
        && (clinicDoc(branchId).data.subscriptionPlan == 'premium'
          || clinicDoc(branchId).data.get('paymentStatus', '') == 'trial');
    }

    match /users/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId
          || isSuperadmin()
          || ((resource.data.branchId != null && canAccessBranch(resource.data.branchId))
            || (resource.data.branchIds != null && userData().branchIds != null
              && userData().branchIds.hasAny(resource.data.branchIds))));
      // Registration profiles and employee profiles are created through the
      // trusted backend. Browser clients cannot choose an initial role,
      // verification state, branch, or permission set.
      allow create: if isSignedIn() && isSuperadmin();
      allow update: if isSignedIn()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['practitionerType'])
        && (!isCustomer()
          || ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['contactNumber'])
              || isValidPhilippineMobile(request.resource.data.contactNumber))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phoneNumber'])
              || isValidPhilippineMobile(request.resource.data.phoneNumber))))
        && ((request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'welcomeNotificationSent', 'welcomeNotificationAt', 'welcomeNotificationRead', 'welcomeNotificationDeleted'
            ]))
          || (request.auth.uid == userId && applicantCannotChangeVerificationFields() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'userType', 'branchId', 'branchIds', 'organizationOwnerId', 'clinicId', 'permissions', 'effectivePermissions', 'customRoleIds', 'customRoleId', 'adminRole']))
          || (request.auth.uid == userId
            && isCustomer()
            && request.resource.data.status == 'Inactive'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'accountDeactivationRequested', 'accountDeactivationReason', 'accountDeactivatedAt', 'accountRecoveryEndsAt', 'updatedAt'
            ]))
          // Customer deletion starts directly and has a 30-day recovery
          // window. It does not require administrator review.
          || (request.auth.uid == userId
            && isCustomer()
            && resource.data.status == 'Active'
            && request.resource.data.status == 'Inactive'
            && request.resource.data.accountDeletionRequested == true
            && request.resource.data.accountDeletionScheduledFor != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'accountDeletionRequested', 'accountDeletionRequestedAt',
              'accountDeletionReason', 'accountDeletionScheduledFor',
              'accountRecoveryEndsAt', 'updatedAt'
            ]))
          // A customer who deactivated their own account may restore it only
          // during the recorded 30-day recovery window. This deliberately
          // does not apply to administrator-closed, rejected, or archived
          // accounts.
          || (request.auth.uid == userId
            && (resource.data.role == 'Customer' || resource.data.userType == 'Customer' || resource.data.userType == 'customer')
            && resource.data.status == 'Inactive'
            && resource.data.accountDeactivationRequested == true
            && resource.data.accountRecoveryEndsAt != null
            && request.time < resource.data.accountRecoveryEndsAt
            && request.resource.data.status == 'Active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'accountDeactivationRequested', 'accountDeactivationReason', 'accountRecoveryEndsAt', 'accountReactivatedAt', 'updatedAt'
            ]))
          || (request.auth.uid == userId
            && isCustomer()
            && resource.data.status == 'Inactive'
            && resource.data.accountDeletionRequested == true
            && resource.data.accountDeletionScheduledFor != null
            && request.time < resource.data.accountDeletionScheduledFor
            && request.resource.data.status == 'Active'
            && request.resource.data.accountDeletionRequested == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'accountDeletionRequested', 'accountDeletionRequestedAt',
              'accountDeletionReason', 'accountDeletionScheduledFor',
              'accountRecoveryEndsAt', 'accountDeletionCancelledAt', 'updatedAt'
            ]))
          // Owner closure recovery is limited to the 30-day hold. The trusted
          // backend restores the clinic branches and employee access together.
          || (request.auth.uid == userId
            && isClinicOwner()
            && resource.data.status == 'Inactive'
            && resource.data.archived == true
            && resource.data.accountClosed == true
            && resource.data.accountClosureAction == 'deactivate'
            && resource.data.accountRecoveryEndsAt != null
            && request.time < resource.data.accountRecoveryEndsAt
            && request.resource.data.status == 'Active'
            && request.resource.data.archived == false
            && request.resource.data.accountClosed == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'archived', 'accountClosed', 'accountClosureAction',
              'accountRecoveryEndsAt', 'accountReactivatedAt', 'updatedAt'
            ]))
          || isSuperadmin()
          || (resource.data.branchId != null
            && isOwnerOfBranch(resource.data.branchId)
            && request.resource.data.branchId != null
            && isOwnerOfBranch(request.resource.data.branchId)
            && hasPermission('staff:update')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branchId', 'clinicBranch', 'clinicLocation', 'updatedAt']))
          || (resource.data.branchId != null
            && canAccessBranch(resource.data.branchId)
            && hasPermission('staff:disable')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'archived', 'archivedAt', 'updatedAt'])
            && request.resource.data.status in ['Pending Activation', 'Active', 'Inactive']
            && request.resource.data.get('archived', false) == (request.resource.data.status == 'Inactive'))
          || (resource.data.branchId != null
            && canAccessBranch(resource.data.branchId)
            && hasPermission('staff:update')
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'archived', 'archivedAt'])
              || hasPermission('staff:disable'))
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['branchId', 'branchIds', 'organizationOwnerId', 'clinicLocation'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['engagementType', 'employmentType', 'weeklyHoursTarget'])
              || (request.resource.data.get('engagementType', resource.data.get('engagementType', 'employee')) in ['employee', 'student_intern']
                && (request.resource.data.get('engagementType', resource.data.get('engagementType', 'employee')) == 'student_intern'
                  ? request.resource.data.get('employmentType', resource.data.get('employmentType', '')) == 'Intern'
                  : request.resource.data.get('employmentType', resource.data.get('employmentType', '')) in ['Full-time', 'Part-time'])
                && request.resource.data.get('weeklyHoursTarget', resource.data.get('weeklyHoursTarget', 0)) is number
                && request.resource.data.get('weeklyHoursTarget', resource.data.get('weeklyHoursTarget', 0)) >= 1
                && request.resource.data.get('weeklyHoursTarget', resource.data.get('weeklyHoursTarget', 0)) <= 48))
            && (request.resource.data.get('engagementType', resource.data.get('engagementType', 'employee')) != 'student_intern'
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['basePay', 'basePayModel', 'monthlyBaseHours']))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'userType', 'clinicId', 'permissions', 'effectivePermissions', 'customRoleIds', 'customRoleId', 'adminRole']) || hasPermission('roles:manage'))));
      allow delete: if isSignedIn()
        && (isSuperadmin()
          || (resource.data.branchId != null
            && canAccessBranch(resource.data.branchId)
            && hasPermission('staff:disable')));
    }

    match /users/{userId}/schedules/{scheduleId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId
          || isSuperadmin()
          // A newly hired employee has no schedule document yet. Authorize
          // the HR schedule manager from the employee's parent profile, not
          // from fields that do not exist on that first schedule document.
          || (exists(/databases/$(database)/documents/users/$(userId))
            && get(/databases/$(database)/documents/users/$(userId)).data.branchId != null
            && canAccessBranch(get(/databases/$(database)/documents/users/$(userId)).data.branchId)
            && (hasPermission('hr:view') || hasPermission('hr:update'))
            && planAllowsWorkforceManagement(get(/databases/$(database)/documents/users/$(userId)).data.branchId))
          // Basic-plan booking availability only needs the employee's
          // recurring schedule; it does not grant access to HR scheduling.
          || (scheduleId == 'recurring'
            && exists(/databases/$(database)/documents/users/$(userId))
            && get(/databases/$(database)/documents/users/$(userId)).data.branchId != null
            && canAccessBranch(get(/databases/$(database)/documents/users/$(userId)).data.branchId)
            && hasPermission('appointments:review')
            && planAllowsBookingAvailability(get(/databases/$(database)/documents/users/$(userId)).data.branchId)));
      allow create: if isSignedIn()
        && request.resource.data.branchId != null
        && canAccessBranch(request.resource.data.branchId)
        && ((hasPermission('hr:update') && planAllowsWorkforceManagement(request.resource.data.branchId))
          || (request.resource.data.recurring == true && hasPermission('appointments:review') && planAllowsBookingAvailability(request.resource.data.branchId)));
      allow update: if isSignedIn()
        && resource.data.branchId != null
        && request.resource.data.branchId == resource.data.branchId
        && canAccessBranch(resource.data.branchId)
        && ((hasPermission('hr:update') && planAllowsWorkforceManagement(resource.data.branchId))
          || (resource.data.recurring == true && request.resource.data.recurring == true && hasPermission('appointments:review') && planAllowsBookingAvailability(resource.data.branchId)));
      allow delete: if isSignedIn()
        && resource.data.branchId != null
        && canAccessBranch(resource.data.branchId)
        && hasPermission('hr:update')
        && planAllowsWorkforceManagement(resource.data.branchId);
    }

    match /clinics/{clinicId} {
      match /documentPreflights/{preflightId} {
        // Content hashes, OCR quality results, and BIR tax candidates are
        // written and consumed by the trusted registration/admin backend only.
        allow read, write: if false;
      }

      // The clinic document also holds registration and verification data.
      // Publication never grants public access to this private record.
      allow read: if isSignedIn()
        && (request.auth.uid == clinicId
          || isSuperadmin() || resource.data.ownerId == request.auth.uid
          || resource.data.get('branchAdminId', '') == request.auth.uid
          || isStaffOfBranch(clinicId));
      // Initial clinics and additional branches are created by trusted
      // registration/branch services so applicants cannot set approval or
      // publication fields in the initial document.
      allow create: if isSignedIn() && isSuperadmin();
      allow update: if isSignedIn()
        && (isSuperadmin()
          || (isOwnerOfBranch(clinicId)
            && ((subscriptionAllowsBusinessWrite(clinicId) && applicantCannotChangeVerificationFields())
              || applicantCanSaveClinicDocumentDraft()
              || ownerCanSaveInitialOnboarding(clinicId)))
          || (isOwnerOfBranch(clinicId) && subscriptionAllowsBusinessWrite(clinicId)
            && hasPermission('clinic_profile:update') && applicantCannotChangeVerificationFields())
          || (isStaffOfBranch(clinicId) && subscriptionAllowsBusinessWrite(clinicId)
            && hasPermission('clinic_profile:update') && applicantCannotChangeVerificationFields()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['branchAdminId']))
          || (isStaffOfBranch(clinicId) && hasPermission('policies:update')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'cancellationPolicy', 'cancellationPolicyEnabled', 'reschedulePolicy', 'reschedulePolicyEnabled',
              'noShowPolicy', 'noShowPolicyEnabled', 'noShowRescheduleAllowed', 'refundPolicy', 'refundPolicyEnabled',
              'consultationPolicy', 'consultationPolicyEnabled', 'serviceTerms', 'serviceTermsEnabled',
              'productTerms', 'productTermsEnabled', 'deliveryPolicy', 'deliveryPolicyEnabled',
              'paymentPolicy', 'paymentPolicyEnabled', 'productOrderCancellationPolicy',
              'productOrderCancellationPolicyEnabled', 'productReturnPolicy',
              'productReturnPolicyEnabled', 'walkInPolicy', 'walkInPolicyEnabled',
              'enforcedPolicyKeys', 'policiesLinkedAt', 'policiesLinkedBy',
              'policiesUpdatedAt', 'updatedAt'
            ])));
      allow delete: if isSignedIn() && isSuperadmin();
    }

    // Public directory records contain only fields selected by the trusted
    // projection writer. Clients must not be able to insert arbitrary private
    // fields into this publicly readable collection.
    match /publicClinics/{clinicId} {
      allow read: if true;
      allow write: if false;
    }

    match /rolePermissions/{roleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperadmin();
    }

    match /clinicRoles/{roleId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid
          || isSuperadmin()
          || isAssignedClinicRole(roleId)
          || isStaffOfOwner(resource.data.ownerId));
      allow create: if isSignedIn()
        && canManageClinicRoles(request.resource.data.ownerId);
      allow update: if isSignedIn()
        && canManageClinicRoles(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        // Built-in identity is immutable so a role manager cannot remove its
        // protection by editing the document through the client SDK.
        && request.resource.data.get('builtinKey', '') == resource.data.get('builtinKey', '')
        && request.resource.data.get('isBuiltIn', false) == resource.data.get('isBuiltIn', false);
      allow delete: if isSignedIn()
        && canManageClinicRoles(resource.data.ownerId)
        && ((resource.data.get('isBuiltIn', false) != true
          && resource.data.get('builtinKey', '') == '')
          || resource.data.get('builtinKey', '') in ['clinic-admin', 'clinic-owner', 'inventory-procurement']);
    }

    match /ownerModuleSettings/{ownerId} {
      allow read: if isSignedIn()
        && (request.auth.uid == ownerId || isSuperadmin() || isStaffOfOwner(ownerId));
      allow create, update: if isSignedIn()
        && (request.auth.uid == ownerId || isSuperadmin());
      allow delete: if isSignedIn()
        && (request.auth.uid == ownerId || isSuperadmin());
    }

    match /planPermissions/{planId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperadmin();
    }

    match /subscriptionFeatures/{featureId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSuperadmin();
    }

    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isSignedIn() && isSuperadmin();
    }

    // System announcements are authored and reviewed only by Super Admins.
    match /systemAnnouncements/{announcementId} {
      allow read, create, update, delete: if isSignedIn() && isSuperadmin();
    }

    match /planPayments/{paymentId} {
      // Payment records are created by the trusted PayMongo verification endpoint.
      // Never trust a browser-provided source/status/amount for financial records.
      allow read: if isSignedIn()
        && (isSuperadmin()
          || resource.data.ownerUid == request.auth.uid
          || resource.data.payerEmail == userData().email);
      allow create: if false;
      allow update, delete: if isSignedIn() && isSuperadmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
          || (resource.data.branchId != null && isOwnerOfBranch(resource.data.branchId))
          || (resource.data.branchId != null && canAccessBranch(resource.data.branchId)
            && (hasPermission('appointments:view') || hasPermission('appointments:update') || hasPermission('appointments:review')
              || (resource.data.get('type', '') == 'Consultation' && hasPermission('consultations:view'))
              || hasPermission('finance:refunds:view') || hasPermission('finance:refunds:manage')))
          || isSuperadmin());
      // Customer bookings are created by the API after availability and policy checks.
      allow create: if isSignedIn()
        && request.resource.data.get('bookingWorkflowVersion', 0) != 2
        && request.resource.data.branchId != null && canAccessBranch(request.resource.data.branchId) && hasPermission('appointments:create');
      allow update: if isSignedIn()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['treatmentTeam', 'staffingRequirements', 'teamAssignedBy', 'staffEarningsStatus', 'staffEarningsApprovedBy', 'staffEarningsReviewNote', 'prescriptions', 'prescription', 'prescriptionStatus', 'prescriptionDispensedAt', 'prescriptionDispensedBy', 'pharmacySaleId'])
        && (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('appointments:update')
            && (resource.data.get('bookingWorkflowVersion', 0) != 2
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'bookingWorkflowVersion', 'status', 'approvalStatus', 'amount', 'totalAmount', 'amountPaid', 'balance',
                'paymentStatus', 'installmentsAllowed', 'depositPercent', 'contract', 'contractRequired',
                'bookingAgreement', 'bookingAgreementRequired', 'bookingForSomeoneElse', 'bookedByName', 'bookedByEmail', 'bookedByPhone',
                'serviceKey', 'customerKeyVerified', 'workerKeyVerified', 'workerCompleted', 'customerCompleted',
                'treatmentTeam', 'staffingRequirements', 'staffEarningsStatus', 'staffEarningsApprovedBy', 'staffEarningsReviewNote', 'teamAssignedBy',
                'resources', 'materialsConsumed', 'startedAt', 'completedAt', 'recordedPaymentSessions'
                , 'checkedInAt', 'checkedInById', 'manualCheckInReason', 'clientJoinedAt', 'practitionerJoinedAt',
                'workerCompletedAt', 'workerCompletedById', 'customerCompletedAt', 'consultationEndedAt',
                'consultationEndedById', 'consultationActualDurationSeconds', 'treatmentNotes', 'aftercareInstructions',
                'consultationClientEndedAt', 'consultationNeedsReview', 'consultationWindowEndedAt', 'consultationEndedByTimer',
                'consultationWindowStartAt', 'consultationWindowEndAt', 'consultationDurationMinutes', 'workerKeyVerifiedAt',
                'customerId', 'customerEmail', 'branchId', 'date', 'time', 'endTime', 'practitionerId', 'assignedPractitionerId',
                'parentAppointmentId', 'groupBookingId', 'groupBooking', 'isGroupRecipient', 'paymentManagedByOrganizer',
                'refundProcessing', 'refundProcessingAt', 'refundProcessingById', 'refundRequestId', 'refundRequestStatus',
                'refundStatus', 'refundType', 'refundMethod', 'refundAmount', 'refundApprovedAmount', 'refundedAmountTotal',
                'refundOperationId', 'refundReference', 'refundFailure', 'refundRejectionReason', 'refundDecisionNote',
                'refundDecisionAt', 'refundDecisionById', 'refundDecisionByName', 'refundedAt', 'paymongoRefundId', 'paymongoRefundStatus',
                'paymongoPaymentId', 'paymongoPaidAt', 'paymongoCheckoutSessionId', 'commissionAmount', 'commissionPercent', 'merchantNetAmount',
                'sessionNumber', 'treatmentSessionId', 'selectedServiceIds', 'selectedServices', 'serviceIds', 'type',
                'consultationAccessVersion', 'consultationCodeVerifiedAt', 'consultationCodeVerifiedBy',
                'consultationCustomerReadyAt', 'consultationInviteAt', 'consultationInviteSentBy',
                'consultationPolicy', 'consultationPresenceVerifiedAt', 'consultationPresenceVerifiedBy',
                'consultationDispute', 'consultationReview', 'consultationReviewReason', 'consultationAdjudicated',
                'consultationInterruption', 'consultationInterruptions', 'consultationExtensionSeconds',
                'consultationConfirmationReminderAt', 'consultationPreviousAttempts',
                'treatmentPlan', 'treatmentPlanAppointmentId', 'bookingOrderId', 'isBookingOrderParent', 'isGroupParent', 'appointmentIds'
              ]))
          // Practitioners can record only their own clinical follow-up and meeting-link metadata.
          // Workflow and financial fields remain restricted to the server workflow or appointment managers.
          || (resource.data.branchId != null && canAccessBranch(resource.data.branchId)
            && (resource.data.practitionerId == request.auth.uid
              || resource.data.assignedPractitionerId == request.auth.uid
              || resource.data.staffId == request.auth.uid
              || resource.data.assignedTo == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'followUpRecommended', 'followUpRecommendationNote', 'followUpRecommendedAt', 'followUpRecommendedById',
              'updatedAt'
            ])));
      allow delete: if isSignedIn()
        && (isSuperadmin() || (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('appointments:update')));
    }

    match /consultationClearances/{clearanceId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('appointments:review')));
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid && request.resource.data.status == 'Pending' && request.resource.data.branchId != null && isPublicClinic(request.resource.data.branchId);
      allow update: if isSignedIn() && resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('appointments:review') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote']);
      allow delete: if false;
    }

    match /treatmentSessions/{sessionId} {
      // Session state is written only through the trusted booking API. The
      // customer may read their own progress; authorized clinic staff may
      // read sessions for their branch.
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
          || (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('appointments:view'))
          || isSuperadmin());
      allow write: if false;
    }
    match /groupBookings/{groupId} {
      allow read: if isSignedIn() && (resource.data.organizerId == request.auth.uid || isSuperadmin()
        || (resource.data.branchId != null && canAccessBranch(resource.data.branchId)
          && (hasPermission('appointments:view') || hasPermission('appointments:update'))));
      allow write: if false;
    }
    match /groupConsentInvitations/{token} { allow read, write: if false; }
    match /bookingCustomerDayLocks/{id} { allow read, write: if false; }

    match /treatmentSessionAudit/{auditId} {
      allow read: if isSignedIn()
        && resource.data.branchId != null
        && canAccessBranch(resource.data.branchId)
        && hasPermission('appointments:view');
      allow write: if false;
    }

    match /clients/{clientId} {
      allow read: if isSignedIn()
        && ((resource.data.branchId != null && (isOwnerOfBranch(resource.data.branchId)
          || (canAccessBranch(resource.data.branchId) && hasPermission('clients:view')))) || isSuperadmin());
      // Client profiles are created and edited only by trusted booking and
      // clinic-directory workflows, which validate the branch and field set.
      allow create, update: if false;
      // Client deletion is not an available clinic action. Profile corrections
      // go through the trusted directory workflow, so no role permission may
      // directly delete client records.
      allow delete: if false;
    }

    match /attendanceDailyQRCodes/{qrId} {
      // The QR payload is handed to the authorized station by the backend;
      // an employee never needs to read its challenge document directly.
      allow read: if isSignedIn()
        && resource.data.branchId != null
        && canAccessBranch(resource.data.branchId)
        && hasPermission('attendance:update')
        && planAllowsWorkforceManagement(resource.data.branchId);
      // QR challenges are minted by the trusted attendance backend only.
      // Clients may read their branch challenge to scan it, but cannot forge,
      // refresh, or modify a challenge directly.
      allow create, update: if false;
      allow delete: if false;
    }

    // Keep Google Meet links private to the appointment participants.
    match /appointmentMeetings/{appointmentId} {
      allow read: if isSignedIn()
        && ((get(/databases/$(database)/documents/appointments/$(appointmentId)).data.customerId == request.auth.uid
            && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.get('consultationCodeVerifiedAt', null) != null
            && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.get('consultationInviteAt', null) != null
            && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.get('workerCompleted', false) != true
            && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.get('status', '') in ['Paid', 'Scheduled', 'Ready to Start', 'Ongoing', 'paid', 'scheduled', 'ready to start', 'ongoing'])
          || get(/databases/$(database)/documents/appointments/$(appointmentId)).data.practitionerId == request.auth.uid
          || get(/databases/$(database)/documents/appointments/$(appointmentId)).data.assignedPractitionerId == request.auth.uid
          || (get(/databases/$(database)/documents/appointments/$(appointmentId)).data.branchId != null
            && canAccessBranch(get(/databases/$(database)/documents/appointments/$(appointmentId)).data.branchId)
            && (hasPermission('consultations:view') || hasPermission('consultations:create'))));
      allow create, update: if false;
      allow delete: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn()
        && ((resource.data.employeeId == request.auth.uid)
          || (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('attendance:view') && planAllowsWorkforceManagement(resource.data.branchId))
          || isSuperadmin());
      allow create, update: if false;
      allow delete: if false;
    }

    match /overtimeRequests/{requestId} {
      allow read: if isSignedIn()
        && (isSuperadmin()
          || (resource.data.requesterId == request.auth.uid)
          || (resource.data.branchId != null
            && canAccessBranch(resource.data.branchId)
            && (hasPermission('overtime:view') || hasPermission('payroll:update'))
            && planAllowsWorkforceManagement(resource.data.branchId)));
      // Requests and decisions are written by the backend after it validates
      // attendance evidence, branch scope, permissions, and reviewer identity.
      allow create, update: if false;
      allow delete: if false;
    }

    match /leavePolicySettings/{branchId} {
      allow read, write: if false;
    }
    match /leavePolicyAudit/{auditId} {
      allow read, write: if false;
    }
    match /leaveRequests/{requestId} {
      allow read: if isSignedIn()
        && (isSuperadmin()
          || (resource.data.requesterId == request.auth.uid)
          || (resource.data.branchId != null
            && canAccessBranch(resource.data.branchId)
            && hasPermission('leave:review')
            && planAllowsWorkforceManagement(resource.data.branchId)));
      // The backend validates scheduled workdays, paid-leave allowance, request
      // overlap, and independent review before writing request changes.
      allow create, update: if false;
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn()
        && ((resource.data.branchId != null && (isOwnerOfBranch(resource.data.branchId)
          || (canAccessBranch(resource.data.branchId)
            && (hasPermission('payments:view') || hasPermission('finance:sales:view') || hasPermission('finance:reports:view'))))) || isSuperadmin());
      allow create, update, delete: if false;
    }

    match /inventoryItems/{itemId} {
      allow read: if isSignedIn()
        && ((resource.data.branchId != null && (isOwnerOfBranch(resource.data.branchId)
          || (canAccessBranch(resource.data.branchId)
          && (hasPermission('inventory:view') || hasPermission('finance:purchases:view') || hasPermission('finance:reports:view'))))) || isSuperadmin());
      allow create, update, delete: if false;
    }

    match /suppliers/{supplierId} {
      // Suppliers are business contact records, never authenticated platform users.
      // Only contacts explicitly marked shared are discoverable outside their clinic.
      allow read: if isSignedIn() && (isSuperadmin()
        || resource.data.sharedDirectory == true
        || resource.data.createdForClinicId == request.auth.uid
        || isStaffOfOwner(resource.data.createdForClinicId)
        || (resource.data.branchId != null && canAccessBranch(resource.data.branchId)
          && (isOwnerOfBranch(resource.data.branchId) || hasPermission('inventory:view') || hasPermission('procurement:view')
            || hasPermission('suppliers:create') || hasPermission('suppliers:update'))));
      allow create: if isSignedIn() && hasPermission('suppliers:create')
        && request.resource.data.createdForClinicId != null
        && (request.resource.data.createdForClinicId == request.auth.uid || isStaffOfOwner(request.resource.data.createdForClinicId))
        && !request.resource.data.keys().hasAny(['ownerId', 'supplierUserId', 'offeredItems', 'verificationStatus']);
      allow update: if isSignedIn() && hasPermission('suppliers:update')
        && (resource.data.createdForClinicId == request.auth.uid || isStaffOfOwner(resource.data.createdForClinicId))
        && request.resource.data.createdForClinicId == resource.data.createdForClinicId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'supplierUserId', 'offeredItems']);
      allow delete: if false;
    }

    match /clinicSuppliers/{associationId} {
      allow read: if isSignedIn() && resource.data.branchId != null
        && canAccessBranch(resource.data.branchId)
        && (isOwnerOfBranch(resource.data.branchId) || hasPermission('inventory:view') || hasPermission('procurement:view')
          || hasPermission('suppliers:create') || hasPermission('suppliers:update'));
      allow create: if isSignedIn() && request.resource.data.branchId != null
        && canAccessBranch(request.resource.data.branchId) && (isOwnerOfBranch(request.resource.data.branchId) || hasPermission('suppliers:create'))
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && resource.data.branchId != null
        && canAccessBranch(resource.data.branchId) && (isOwnerOfBranch(resource.data.branchId) || hasPermission('suppliers:update'))
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.clinicId == resource.data.clinicId
        && request.resource.data.supplierId == resource.data.supplierId;
      // Associations are retained for history; mark inactive instead of deleting.
      allow delete: if false;
    }

    match /appointmentAudit/{id} { allow read: if isSignedIn() && (isSuperadmin() || (canAccessBranch(resource.data.branchId) && hasPermission('appointments:view'))); allow write: if false; }

    match /purchaseRequests/{requestId} {
      allow read: if isSignedIn()
        && ((resource.data.branchId != null
          && (isOwnerOfBranch(resource.data.branchId)
            || (canAccessBranch(resource.data.branchId)
              && (hasPermission('inventory:view') || hasPermission('orders:view') || hasPermission('procurement:view') || hasPermission('finance:payables:view') || hasPermission('finance:purchases:view') || hasPermission('finance:reports:view')))))
          || isSuperadmin()
          || (resource.data.supplierId != null
            && get(/databases/$(database)/documents/suppliers/$(resource.data.supplierId)).data.ownerId == request.auth.uid));
      // Historical records remain readable for reports. All new procurement writes
      // use the server-authoritative supplyRecords workflow.
      allow create, update, delete: if false;
    }

    // Financial records are created and settled through the trusted backend.
    // Clients can only read records for branches they are authorized to view.
    match /financialRecords/{recordId} {
      allow read: if isSignedIn() && resource.data.branchId != null
        && canAccessBranch(resource.data.branchId)
        && (hasPermission('finance:payables:view') || hasPermission('finance:reports:view'));
      allow create, update, delete: if false;
    }

    match /financeAudit/{auditId} {
      allow read: if isSignedIn() && resource.data.branchId != null
        && canAccessBranch(resource.data.branchId)
        && (hasPermission('finance:payables:view') || hasPermission('finance:reports:view'));
      allow create, update, delete: if false;
    }

    match /financialPayments/{paymentId} {
      allow read: if isSignedIn() && resource.data.branchId != null
        && canAccessBranch(resource.data.branchId)
        && (hasPermission('finance:payables:view') || hasPermission('finance:reports:view'));
      allow create, update, delete: if false;
    }

    match /productServicePosts/{postId} {
      function draft() {
        return request.resource.data.get('financeStatus', '') == 'draft'
          && request.resource.data.get('isPublished', true) == false
          && request.resource.data.get('financeReview', null) == null
          && request.resource.data.get('publishedBy', null) == null
          && request.resource.data.get('publishedAt', null) == null;
      }
      function financialChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'price', 'consultationFee', 'allowInstallments', 'depositPercent', 'discountPercent', 'discountAmount'
        ]);
      }
      allow read: if (isCustomerDiscoverablePublicClinic(resource.data.branchId)
          && resource.data.get('financeStatus', '') == 'approved' && resource.data.get('isPublished', false) == true)
        || (isSignedIn() && canAccessBranch(resource.data.branchId));
      allow create: if isSignedIn() && canAccessBranch(request.resource.data.branchId)
        && hasPermission('services:create') && draft();
      allow update: if isSignedIn() && canAccessBranch(resource.data.branchId) && hasPermission('services:update')
        && request.resource.data.branchId == resource.data.branchId
        && ((financialChange() && draft()) || (!financialChange()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'financeStatus', 'financeReview', 'isPublished', 'publishedBy', 'publishedAt', 'submittedBy'
          ])));
      allow delete: if isSignedIn() && canAccessBranch(resource.data.branchId) && hasPermission('services:disable');
      match /approvalHistory/{entryId} {
        allow read: if isSignedIn() && canAccessBranch(get(/databases/$(database)/documents/productServicePosts/$(postId)).data.branchId);
        allow write: if false;
      }
    }

    // One policy document belongs to one clinic organization (the clinic
    // owner's UID), not to an individual branch. Branches inherit it.
    match /clinicPolicies/{clinicOwnerId} {
      allow read: if isSignedIn() && (isSuperadmin()
        || request.auth.uid == clinicOwnerId
        || isStaffOfOwner(clinicOwnerId));
      allow create: if isSignedIn() && (isSuperadmin()
        || ((request.auth.uid == clinicOwnerId
          || (isStaffOfOwner(clinicOwnerId) && hasPermission('policies:update')))
          && !request.resource.data.keys().hasAny(['vatRegistered', 'taxProfile'])))
        && request.resource.data.ownerId == clinicOwnerId;
      allow update: if isSignedIn() && (isSuperadmin()
        || ((request.auth.uid == clinicOwnerId
          || (isStaffOfOwner(clinicOwnerId) && hasPermission('policies:update')))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['vatRegistered', 'taxProfile'])))
        && request.resource.data.ownerId == clinicOwnerId;
      allow delete: if false;
    }

    match /supplierQuotes/{quoteId} {
      allow read: if isSignedIn()
        && get(/databases/$(database)/documents/suppliers/$(resource.data.supplierId)).data.ownerId == request.auth.uid;
      allow read: if isSignedIn()
        && (isSuperadmin() || (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('procurement:view')));
      allow create, update, delete: if false;
    }

    match /purchaseOrders/{orderId} {
      allow read: if isSignedIn()
        && (isSuperadmin() || (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('procurement:view')));
      allow create, update, delete: if false;
    }

    match /manualPurchases/{purchaseId} {
      allow read: if isSignedIn()
        && (isSuperadmin() || (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('procurement:view')));
      allow create, update, delete: if false;
    }

    // Staff agreements and earning snapshots are private and server-managed.
    match /practitionerProfiles/{id} { allow read, write: if false; }
    match /appointmentStaffTerms/{id} { allow read, write: if false; }
    match /practitionerProfileAudit/{id} { allow read, write: if false; }
    match /staffEarnings/{id} { allow read, write: if false; }

    match /commissionContracts/{contractId} {
      allow read: if isSignedIn()
        && (isSuperadmin() || (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('commissions:view')));
      allow create, update: if isSignedIn()
        && request.resource.data.branchId != null && isOwnerOfBranch(request.resource.data.branchId)
        && (hasPermission('commissions:manage') || isOwnerOfBranch(request.resource.data.branchId));
      allow delete: if false;
    }

    match /archivedProductServicePosts/{postId} {
      allow read: if isSignedIn()
        && (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('services:view'));
      allow create, update: if isSignedIn()
        && (request.resource.data.branchId != null && canAccessBranch(request.resource.data.branchId) && hasPermission('services:disable'));
      allow delete: if isSignedIn()
        && resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('services:disable');
    }

    match /archivedSuppliers/{supplierId} {
      allow read: if isSignedIn()
        && (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('inventory:view'));
      allow create, update: if isSignedIn()
        && (request.resource.data.branchId != null && canAccessBranch(request.resource.data.branchId) && hasPermission('inventory:disable'));
      allow delete: if isSignedIn()
        && resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('inventory:disable');
    }

    match /messages/{messageId} {
      allow read: if isSignedIn()
        && resource.data.branchId is string
        && canUseClinicInbox(resource.data.branchId);
      allow create: if isCustomer()
        && request.resource.data.keys().hasAll([
          'branchId', 'branchName', 'threadId', 'customerId', 'senderId',
          'subject', 'senderName', 'senderEmail', 'body', 'isRead', 'type', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'branchId', 'branchName', 'threadId', 'customerId', 'senderId',
          'subject', 'senderName', 'senderEmail', 'body', 'isRead', 'type', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.type == 'chat'
        && request.resource.data.isRead == false
        && request.resource.data.branchId is string
        && exists(/databases/$(database)/documents/clinics/$(request.resource.data.branchId))
        && request.resource.data.threadId == request.resource.data.branchId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/chatThreads/$(request.resource.data.threadId))
        && get(/databases/$(database)/documents/chatThreads/$(request.resource.data.threadId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/chatThreads/$(request.resource.data.threadId)).data.branchId == request.resource.data.branchId
        && isShortMessage(request.resource.data.body)
        && request.resource.data.branchName is string
        && request.resource.data.branchName.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 120
        && request.resource.data.senderEmail is string
        && request.resource.data.senderEmail.size() <= 254
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isSignedIn()
        && resource.data.branchId is string
        && canUseClinicInbox(resource.data.branchId)
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.threadId == resource.data.threadId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt'])
        && request.resource.data.isRead == true
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isPublicClinic(resource.data.branchId)
        || (isSignedIn() && canAccessBranch(resource.data.branchId));
      allow create, update, delete: if false;
    }

    match /chatThreads/{threadId} {
      allow read: if isSignedIn()
        && ((resource.data.customerId == request.auth.uid)
          || canUseClinicInbox(resource.data.branchId));
      allow create: if isCustomer()
        && request.resource.data.keys().hasAll(['branchId', 'customerId', 'customerName', 'customerEmail', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['branchId', 'customerId', 'customerName', 'customerEmail', 'updatedAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && exists(/databases/$(database)/documents/clinics/$(request.resource.data.branchId))
        && threadId == request.resource.data.branchId + '_' + request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.size() <= 254
        && request.resource.data.updatedAt is timestamp;
      allow update: if isSignedIn()
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.branchId == resource.data.branchId
        && ((isCustomer()
            && resource.data.customerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'customerName', 'customerEmail', 'customerLastReadAt',
              'branchName', 'lastMessage', 'lastMessageAt', 'updatedAt'
            ])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerName'])
              || (request.resource.data.customerName is string && request.resource.data.customerName.size() <= 120))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerEmail'])
              || (request.resource.data.customerEmail is string && request.resource.data.customerEmail.size() <= 254))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerLastReadAt'])
              || request.resource.data.customerLastReadAt is timestamp)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['branchName'])
              || (request.resource.data.branchName is string && request.resource.data.branchName.size() <= 200))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage'])
              || isShortMessage(request.resource.data.lastMessage))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageAt'])
              || request.resource.data.lastMessageAt is timestamp)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
              || request.resource.data.updatedAt is timestamp))
          || (canUseClinicInbox(resource.data.branchId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage'])
              || isShortMessage(request.resource.data.lastMessage))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageAt'])
              || request.resource.data.lastMessageAt is timestamp)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
              || request.resource.data.updatedAt is timestamp)));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (threadCustomerOwns(threadId) || clinicCanUseThread(threadId));
        allow create: if isSignedIn()
          && request.resource.data.keys().hasAll(['text', 'senderId', 'senderName', 'senderRole', 'createdAt'])
          && request.resource.data.keys().hasOnly([
            'text', 'senderId', 'senderName', 'senderEmail', 'senderRole', 'createdAt', 'clientCreatedAt', 'quickAnswerKey'
          ])
          && isShortMessage(request.resource.data.text)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.createdAt is timestamp
          && (!('clientCreatedAt' in request.resource.data) || request.resource.data.clientCreatedAt is int)
          && (!('quickAnswerKey' in request.resource.data)
            || (request.resource.data.senderRole == 'customer'
              && request.resource.data.quickAnswerKey in ['services', 'contact', 'location', 'price', 'booking']))
          && ((isCustomer()
              && threadCustomerOwns(threadId)
              && request.resource.data.senderRole == 'customer'
              && (!('senderEmail' in request.resource.data)
                || (request.resource.data.senderEmail is string && request.resource.data.senderEmail.size() <= 254)))
            || (clinicCanUseThread(threadId)
              && request.resource.data.senderRole == 'clinic'));
        allow update, delete: if false;
      }
    }

    match /activities/{activityId} {
      allow read: if isSignedIn()
        && (isSuperadmin() || (resource.data.branchId != null && canAccessBranch(resource.data.branchId)));
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && ((isSuperadmin()
          && request.resource.data.branchId == null)
          || (request.resource.data.branchId != null && canAccessBranch(request.resource.data.branchId)));
      allow update, delete: if false;
    }

    match /shifts/{shiftId} {
      allow read: if isSignedIn()
        && ((resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('hr:view') && planAllowsWorkforceManagement(resource.data.branchId)) || isSuperadmin());
      allow create: if isSignedIn()
        && (request.resource.data.branchId != null && canAccessBranch(request.resource.data.branchId) && hasPermission('hr:create') && planAllowsWorkforceManagement(request.resource.data.branchId));
      allow update: if isSignedIn()
        && (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('hr:update') && planAllowsWorkforceManagement(resource.data.branchId));
      // Shift templates are archived by HR instead of deleted so recurring
      // employee schedules and historical appointments keep their reference.
      allow delete: if false;
    }

    function editablePayrollMonth(branchId, month) {
      return !exists(/databases/$(database)/documents/payrollSummaries/$(branchId + '_' + month))
        || get(/databases/$(database)/documents/payrollSummaries/$(branchId + '_' + month)).data.status != 'approved';
    }
    match /payrolls/{payrollId} {
      allow read: if isSignedIn() && ((canAccessBranch(resource.data.branchId) && hasPermission('payroll:view') && planAllowsWorkforceManagement(resource.data.branchId)) || isSuperadmin());
      allow create: if isSignedIn() && canAccessBranch(request.resource.data.branchId) && hasPermission('payroll:update') && planAllowsWorkforceManagement(request.resource.data.branchId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.payPeriodMonthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && editablePayrollMonth(request.resource.data.branchId, request.resource.data.payPeriodMonthKey);
      allow update: if isSignedIn() && canAccessBranch(resource.data.branchId) && hasPermission('payroll:update') && planAllowsWorkforceManagement(resource.data.branchId)
        && request.resource.data.createdBy == resource.data.get('createdBy', request.auth.uid)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.branchId == resource.data.branchId && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.payPeriodMonthKey == resource.data.get('payPeriodMonthKey', request.resource.data.payPeriodMonthKey)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['payslipReleasedAt', 'paymentStatus', 'paidAt'])
        && editablePayrollMonth(resource.data.branchId, request.resource.data.payPeriodMonthKey);
      allow delete: if false;
    }
    match /payrollSummaries/{summaryId} {
      allow read: if isSignedIn() && ((canAccessBranch(resource.data.branchId) && (hasPermission('payroll:view') || hasPermission('finance:reports:view')) && planAllowsWorkforceManagement(resource.data.branchId)) || isSuperadmin());
      allow create, update: if false;
      allow delete: if false;
    }
    match /payslips/{payslipId} {
      allow read: if isSignedIn() && ((canAccessBranch(resource.data.branchId) && hasPermission('payroll:view') && planAllowsWorkforceManagement(resource.data.branchId)) || isSuperadmin());
      allow write: if false;
    }
    match /users/{employeeId}/payslips/{payslipId} {
      // Released payslips are personal payroll records. Employees retain read
      // access to their own released copies even if the clinic plan later lapses.
      allow read: if isSignedIn() && (request.auth.uid == employeeId || (canAccessBranch(resource.data.branchId) && hasPermission('payroll:view') && planAllowsWorkforceManagement(resource.data.branchId)) || isSuperadmin());
      allow write: if false;
    }

    match /payrollSettings/{branchId} {
      allow read: if isSignedIn()
        && canAccessBranch(branchId)
        && hasPermission('payroll:view')
        && planAllowsWorkforceManagement(branchId);
      // Settings writes are validated and audited by the authenticated payroll API.
      allow create, update: if false;
      allow delete: if false;
    }

    match /payrollSettingsAudit/{auditId} {
      allow read: if isSignedIn()
        && resource.data.branchId != null
        && canAccessBranch(resource.data.branchId)
        && hasPermission('payroll:view')
        && planAllowsWorkforceManagement(resource.data.branchId);
      allow create: if false;
      allow update, delete: if false;
    }

    // Owner Finance reads historical aggregate snapshots for its own
    // organization. These records are backend-managed and never writable
    // from the browser.
    match /financeHistory/{historyId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isSuperadmin());
      allow create, update, delete: if false;
    }


    match /patients/{patientId} {
      allow read: if isSignedIn()
        && (resource.data.branchId != null && canAccessBranch(resource.data.branchId));
      allow create, update: if isSignedIn()
        && (request.resource.data.branchId != null && canAccessBranch(request.resource.data.branchId));
      allow delete: if false;
    }

    match /backups/{backupId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isSuperadmin() || hasPermission('backups:view'));
      allow create: if isSignedIn()
        && (request.resource.data.ownerId == request.auth.uid || isSuperadmin() || hasPermission('backups:create'));
      allow update, delete: if false;
    }

    match /customerOrders/{orderId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || (canAccessBranch(resource.data.branchId) && (hasPermission('orders:view') || hasPermission('orders:update') || hasPermission('finance:refunds:view') || hasPermission('finance:refunds:manage') || hasPermission('finance:sales:view'))) || isSuperadmin());
      allow create: if false;
      allow update: if isSignedIn() && ((resource.data.customerId == request.auth.uid
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'receivedAt', 'deliveryProofUrl', 'deliveryProofPath', 'deliveryRating', 'deliveryReview', 'updatedAt']) && resource.data.status in ['Ready for Pickup', 'Picked Up', 'Delivered', 'Received'] && request.resource.data.status == 'Completed')
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderNumber', 'updatedAt'])))
        || (canAccessBranch(resource.data.branchId) && hasPermission('orders:update') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riderName', 'riderPhone', 'riderVehicle', 'riderAssignedAt', 'riderAssignedBy', 'updatedAt'])));
      allow delete: if false;
    }
    match /inventoryMovements/{id} {
      allow read: if isSignedIn() && canAccessBranch(resource.data.branchId) && hasPermission('inventory:view');
      allow write: if false;
    }
    match /purchasePayments/{id} {
      allow read: if isSignedIn() && canAccessBranch(resource.data.branchId) && hasPermission('finance:payables:view');
      allow write: if false;
    }

    match /refundRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
          || (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && (hasPermission('finance:refunds:view') || hasPermission('finance:refunds:manage')))
          || isSuperadmin());
      // Refund requests and decisions are created and changed only by the trusted API.
      allow create, update: if false;
      allow delete: if false;
    }

    match /refundOperations/{operationId} {
      // Provider submissions and settlement records are managed by the trusted API.
      allow read, write: if false;
    }

    match /refundVouchers/{voucherId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
          || (resource.data.branchId != null && canAccessBranch(resource.data.branchId) && hasPermission('finance:refunds:view'))
          || isSuperadmin());
      allow create, update, delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isSuperadmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 5000
        && request.resource.data.category in [
          'Bug/Error', 'Data Issue', 'Performance', 'Billing/Payments',
          'Clinic Complaint', 'Service Complaint', 'Employee Complaint',
          'Feature Request', 'Other'
        ]
        && request.resource.data.severity in ['Low', 'Medium', 'High', 'Critical']
        && request.resource.data.status == 'Open'
        && request.resource.data.branchId is string
        && (
          request.resource.data.branchId == ''
          || request.resource.data.branchId == userData().branchId
          || isPublicClinic(request.resource.data.branchId)
        );
      allow update: if isSignedIn() && isSuperadmin();
      allow delete: if false;
    }

    match /registrationRejectionHistory/{historyId} {
      allow read: if isSignedIn() && isSuperadmin();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && (resource.data.get('recipientUserId', '') == request.auth.uid
          || (resource.data.get('recipientRole', '') == roleKey() && (roleKey() == 'Superadmin' || (resource.data.get('branchId', '') != '' && canAccessBranch(resource.data.branchId))))
          || isSuperadmin());
      allow create: if isSignedIn()
        && ((request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientRole == 'Superadmin')
          || (request.resource.data.senderId == request.auth.uid
            && request.resource.data.recipientUserId == request.auth.uid)
          || (isSuperadmin() && request.resource.data.recipientUserId != null));
      allow update: if isSignedIn()
        && (resource.data.get('recipientUserId', '') == request.auth.uid || isSuperadmin()
          || (resource.data.get('recipientRole', '') == roleKey()
            && (roleKey() == 'Superadmin' || (resource.data.get('branchId', '') != '' && canAccessBranch(resource.data.branchId)))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            && request.resource.data.read == true));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
