rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['Superadmin', 'SuperAdmin', 'superadmin'];
    }

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function canAccessBranch(branchId) {
      return isSignedIn()
        && (firestore.get(/databases/(default)/documents/clinics/$(branchId)).data.ownerId == request.auth.uid
          || userData().branchId == branchId);
    }

    function canAccessSupplierOwner(ownerId) {
      return isSignedIn()
        && (request.auth.uid == ownerId
          || isSuperadmin()
          || userData().get('ownerId', '') == ownerId
          || userData().get('owner', '') == ownerId
          || userData().organizationOwnerId == ownerId
          || (userData().branchId != null
            && (firestore.get(/databases/(default)/documents/clinics/$(userData().branchId)).data.get('ownerId', '') == ownerId
              || firestore.get(/databases/(default)/documents/clinics/$(userData().branchId)).data.get('organizationOwnerId', '') == ownerId)));
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function isDocumentUpload() {
      return request.resource != null
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf')
        // The registration UI accepts files up to 10 MB.
        && request.resource.size <= 10 * 1024 * 1024;
    }

    function isSupplierLtoUpload() {
      return request.resource != null
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }

    function isLeaveAttachmentUpload() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp', 'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];
    }

    function isOrderOwner(orderId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/customerOrders/$(orderId)).data.customerId == request.auth.uid;
    }
    
    match /supplier-item-images/{userId}/{itemId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperadmin());
      allow create, update, delete: if false;
    }

    match /supplier-fda-documents/{ownerId}/{supplierId}/{fileName} {
      // LTO documents are readable by clinic members only. New uploads are
      // immutable so a document can only be replaced with a new file name.
      allow read: if canAccessSupplierOwner(ownerId);
      allow create: if canAccessSupplierOwner(ownerId) && isSupplierLtoUpload();
      allow update, delete: if false;
    }

    match /supplier-fda-documents/{userId}/{fileName} {
      // Older files do not identify a clinic owner reliably, so keep them
      // private until their owning clinic can be confirmed and migrated.
      allow read: if false;
      allow write: if false;
    }

    match /attendanceProofs/{branchId}/{userId}/{date}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isImageUpload();
      allow update, delete: if false;
    }

    match /faceRegistrations/{userId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isImageUpload();
      allow update, delete: if false;
    }

    // Self-service account profile photos. Files are immutable because the
    // client creates a fresh timestamped filename for each replacement.
    match /userProfiles/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperadmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isImageUpload();
      allow update, delete: if false;
    }

    // Supplier profile photos use their own immutable, user-scoped path.
    match /supplier-profile-images/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperadmin());
      allow create, update, delete: if false;
    }

    match /product-service-posts/{branchId}/{fileName} {
      allow read: if isSignedIn() && canAccessBranch(branchId);
      allow create: if canAccessBranch(branchId) && isImageUpload();
      allow update, delete: if false;
    }

    match /product-fda-documents/{branchId}/{fileName} {
      allow read: if isSignedIn() && (canAccessBranch(branchId) || isSuperadmin());
      allow create: if canAccessBranch(branchId) && isDocumentUpload();
      allow update, delete: if false;
    }

    match /clinicMedia/{clinicId}/{fileName} {
      allow read: if isSignedIn() && canAccessBranch(clinicId);
      allow create: if canAccessBranch(clinicId)
        && request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /clinic-registration/{ownerId}/{documentType}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == ownerId || isSuperadmin());
      allow create: if request.auth != null && request.auth.uid == ownerId && isDocumentUpload();
      allow update, delete: if false;
    }

    // Signed clinic agreements are written by the trusted backend only.
    match /clinic-agreements/{ownerId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == ownerId || isSuperadmin());
      allow create, update, delete: if false;
    }

    // Leave-request attachments are immutable and may only be uploaded by
    // the employee whose UID is encoded in the path.
    match /leave-requests/{userId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isLeaveAttachmentUpload();
      allow update, delete: if false;
    }

    match /support-tickets/{userId}/{ticketId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperadmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isImageUpload();
      allow update, delete: if false;
    }

    match /purchase-receipts/{branchId}/{fileName} {
      allow read: if isSignedIn() && (canAccessBranch(branchId) || isSuperadmin());
      allow create: if canAccessBranch(branchId) && isImageUpload();
      allow update, delete: if false;
    }

    match /order-receipts/{orderId}/{fileName} {
      allow read: if isSignedIn() && isOrderOwner(orderId);
      allow create: if isOrderOwner(orderId) && isImageUpload();
      allow update, delete: if false;
    }

    match /refund-requests/{orderId}/{fileName} {
      allow read: if isSignedIn() && isOrderOwner(orderId);
      allow create: if isOrderOwner(orderId) && isImageUpload();
      allow update, delete: if false;
    }
    
    match /backups/{ownerId}/{backupId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == ownerId;
      allow create: if isSignedIn() && request.auth.uid == ownerId;
      allow update, delete: if false;
    }

    // Business verification documents are served through short-lived URLs by the review API.
    match /practitioner-licenses/{uploaderId}/{staffId}/{fileName} {
      allow read: if isSignedIn()
        && (request.auth.uid == uploaderId || request.auth.uid == staffId || isSuperadmin());
      allow create: if isSignedIn()
        && (request.auth.uid == uploaderId || request.auth.uid == staffId)
        && request.resource != null
        && request.resource.contentType in ['image/jpeg', 'image/png']
        && request.resource.size <= 5 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
