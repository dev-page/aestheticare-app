rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['Superadmin', 'SuperAdmin', 'superadmin'];
    }

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function canAccessBranch(branchId) {
      return isSignedIn()
        && (firestore.get(/databases/(default)/documents/clinics/$(branchId)).data.ownerId == request.auth.uid
          || userData().branchId == branchId);
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function isDocumentUpload() {
      return request.resource != null
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function isOrderOwner(orderId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/customerOrders/$(orderId)).data.customerId == request.auth.uid;
    }
    
    match /attendanceProofs/{branchId}/{userId}/{date}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isImageUpload();
      allow update, delete: if false;
    }

    match /faceRegistrations/{userId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isImageUpload();
      allow update, delete: if false;
    }

    match /product-service-posts/{branchId}/{fileName} {
      allow read: if isSignedIn() && canAccessBranch(branchId);
      allow create: if canAccessBranch(branchId) && isImageUpload();
      allow update, delete: if false;
    }

    match /product-fda-documents/{branchId}/{fileName} {
      allow read: if isSignedIn() && (canAccessBranch(branchId) || isSuperadmin());
      allow create: if canAccessBranch(branchId) && isDocumentUpload();
      allow update, delete: if false;
    }

    match /clinicMedia/{clinicId}/{fileName} {
      allow read: if isSignedIn() && canAccessBranch(clinicId);
      allow create: if canAccessBranch(clinicId)
        && request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /clinic-registration/{ownerId}/{documentType}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == ownerId || isSuperadmin());
      allow create: if request.auth != null && request.auth.uid == ownerId && isDocumentUpload();
      allow update, delete: if false;
    }

    match /support-tickets/{userId}/{ticketId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isImageUpload();
      allow update, delete: if false;
    }

    match /purchase-receipts/{branchId}/{fileName} {
      allow read: if isSignedIn() && (canAccessBranch(branchId) || isSuperadmin());
      allow create: if canAccessBranch(branchId) && isImageUpload();
      allow update, delete: if false;
    }

    match /order-receipts/{orderId}/{fileName} {
      allow read: if isSignedIn() && isOrderOwner(orderId);
      allow create: if isOrderOwner(orderId) && isImageUpload();
      allow update, delete: if false;
    }

    match /refund-requests/{orderId}/{fileName} {
      allow read: if isSignedIn() && isOrderOwner(orderId);
      allow create: if isOrderOwner(orderId) && isImageUpload();
      allow update, delete: if false;
    }
    
    match /backups/{ownerId}/{backupId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == ownerId;
      allow create: if isSignedIn() && request.auth.uid == ownerId;
      allow update, delete: if false;
    }

    match /practitioner-licenses/{uploaderId}/{staffId}/{fileName} {
      allow read: if isSignedIn()
        && (request.auth.uid == uploaderId || request.auth.uid == staffId || isSuperadmin());
      allow create: if isSignedIn()
        && (request.auth.uid == uploaderId || request.auth.uid == staffId)
        && isDocumentUpload();
      allow update, delete: if false;
    }
  }
}
